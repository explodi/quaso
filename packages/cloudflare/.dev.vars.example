# Secrets for local runs (deno task cf:dev): copy this file to .dev.vars, which git ignores,
# and fill it in. Deployed instances get SECRET_KEY and SETUP_KEY from deno task cf:setup;
# set others with: wrangler secret put <NAME> --name <worker>

# openssl rand -hex 32
SECRET_KEY=
# The Gemini key and email are entered in Settings, like every other setting.

# Optional, passed to the server as they are. Deployed, set them with wrangler secret put.
# SETUP_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# LOG_LEVEL=info
# Only when the website is served from another origin:
# CORS_ORIGINS=https://yourgame.com
