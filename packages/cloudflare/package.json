{
  "name": "@quaso/cloudflare",
  "private": true,
  "license": "MIT",
  "description": "Quaso on Cloudflare: a Worker and container controller with private D1 and R2 storage.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "types": "wrangler types --strict-vars false",
    "types:check": "wrangler types --strict-vars false --check",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.136.3"
  },
  "dependencies": {
    "@quaso/core": "workspace:*",
    "@quaso/service": "workspace:*"
  }
}
