// SPDX-License-Identifier: MIT
//
// The configuration for the tests in workerd (`deno task cf:test`): the Worker and the data
// object as in wrangler.jsonc, without the container (which needs Docker and an account).
// QUASO_CONTAINER is bound to a fake server instead (worker.ts here), and TEST_OBJECT is a
// bare Durable Object for the adapters' tests. The secrets are test values. It lives in
// test/ so that a developer's .dev.vars (next to wrangler.jsonc) never reaches the tests.
{
  "name": "quaso-test",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "alias": {
    "@quaso/core": "../../core/mod.ts",
    "@quaso/service": "../../service/mod.ts",
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUASO_DATA", "class_name": "QuasoData" },
      { "name": "QUASO_CONTAINER", "class_name": "FakeContainer" },
      { "name": "TEST_OBJECT", "class_name": "TestObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuasoData", "FakeContainer", "TestObject"] },
  ],
  // The nightly backups' bucket, in Miniflare.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "quaso-test-backups" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "quaso-test-d1", "database_id": "local-test-d1" },
    { "binding": "TEST_D1", "database_name": "quaso-test-d1", "database_id": "local-test-d1" },
  ],
  "vars": {
    "PUBLIC_URL": "https://quaso.test",
    "LOCATION_HINT": "weur",
    "GEMINI_MODEL": "",
    "LLM_CONCURRENCY": "4",
    "LLM_MONTHLY_TOKEN_BUDGET": "",
    "CONTAINER_SLEEP_AFTER": "10m",
    "BACKUP_RETENTION_DAYS": "30",
    "SECRET_KEY": "test-secret-key-test-secret-key-test-secret-key",
    "SERVICE_TOKEN": "test-service-token",
    "GEMINI_API_KEY": "",
  },
}
