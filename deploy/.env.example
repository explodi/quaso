# SPDX-License-Identifier: MIT
# Quaso's settings (design §5.12). Copy this file to .env next to compose.yaml, and set the
# public host name. Everything else is optional: a commented-out line shows the default. Empty
# values count as not set.

# ---------------------------------------------------------------------------------------
# Set the public host name.

# Your Quaso's public host name, such as translate.yourgame.com. Caddy gets its HTTPS
# certificate for it, and PUBLIC_URL defaults to https://QUASO_DOMAIN.
QUASO_DOMAIN=
# Generate with `openssl rand -hex 16`, then enter it at /setup. Never commit this value.
SETUP_KEY=
# Enter the Gemini API key and choose LLM limits in Settings after setup.

# ---------------------------------------------------------------------------------------
# Behind Caddy

# Trust the X-Forwarded-For and X-Request-Id headers of the proxy in front (Caddy, in the
# Compose file). Leave it false when nothing is in front of Quaso.
TRUST_PROXY=true

# ---------------------------------------------------------------------------------------
# Optional

# Instance signing and hashing credentials are generated in the database.
# Legacy remote-service mode only (removed in Beta 2):
# SECRET_KEY=
# The address used in links and OAuth callbacks, when it isn't https://QUASO_DOMAIN.
# PUBLIC_URL=https://translate.yourgame.com
# The port Quaso listens on, and the folder for its database, backups and generated key.
# The Docker image sets both; change them only when running Quaso without it.
# PORT=8000
# DATA_DIR=/data
# Logs: debug, info, warn or error.
# LOG_LEVEL=info

# Email, for address verification, password resets and sign-in links: resend or postmark,
# its API key, and the sender, such as Quaso <quaso@yourgame.com>. Set all three, or none.
# Configure the email provider, sender and key in Settings → Email.

# Extra sign-in buttons: an OAuth app's client ID and secret. Set both, or neither.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# An optional human check (Cloudflare Turnstile) on the sign-up and volunteer forms: the
# widget's site key and secret key. Set both, or neither.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Other origins allowed to call the API with credentials (CORS), comma-separated, such as
# https://www.yourgame.com. Only needed when the website is served from another origin.
# CORS_ORIGINS=

# The built website. The Docker image has it inside; set this only to serve another build.
# WEB_DIR=

# A development instance, as `deno task dev` runs it. Never on a public server.
# QUASO_DEV=0

# ---------------------------------------------------------------------------------------
# Cloudflare storage: the data in a Durable Object instead of DATA_DIR (docs/deploy-cloudflare.md,
# "A VM with Cloudflare storage"). Then SECRET_KEY is required, and DATA_DIR and the BACKUP_
# settings don't apply.

# The Worker's internal API (https), such as https://translate.yourgame.com/internal, and the
# token it requires: the Worker's SERVICE_TOKEN secret.
# SERVICES_URL=
# SERVICE_TOKEN=
# Set by the Cloudflare controller for private D1/R2 storage. Leave unset on Docker/VMs.
# QUASO_CLOUDFLARE=
# Where the Durable Object is created: wnam, enam, sam, weur, eeur, apac, oc, afr or me.
# LOCATION_HINT=

# Worker-only variables, set in each wrangler.jsonc environment, not the Docker server.
# How long an idle Cloudflare container stays awake (staging uses 5m).
# Set CONTAINER_SLEEP_AFTER to 10m in wrangler.jsonc.
# File history and backup retention are configured in Settings → Retention.
