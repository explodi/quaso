{
  "name": "quaso-workspace",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:reset": "node scripts/dev.ts --reset",
    "design:tokens": "node scripts/generate_theme.ts",
    "test": "vitest run --project unit",
    "test:llm": "node scripts/llm_eval.ts",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && node scripts/check_headers.ts && node scripts/check_portability.ts && node scripts/check_licenses.ts && npm test",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:web",
    "build:web": "cd packages/web && vite build",
    "build:cli": "node scripts/build_cli.ts",
    "docker": "docker build -f deploy/Dockerfile -t quaso:dev .",
    "docker:smoke": "npm run docker && node scripts/docker_smoke.ts",
    "e2e": "npm run build:cli && vitest run --project e2e",
    "e2e:browser": "puppeteer browsers install chrome",
    "site": "cd site && vite",
    "site:build": "node site/build.ts",
    "site:preview": "npm run site:build && cd site && vite preview",
    "cli": "node scripts/cli_dev.ts",
    "cf:dev": "cd packages/cloudflare && wrangler dev",
    "cf:test": "cd packages/cloudflare && vitest run",
    "cf:types": "cd packages/cloudflare && wrangler types --strict-vars false",
    "cf:fixtures": "node packages/cloudflare/scripts/fixtures.ts",
    "cf:build": "cd packages/cloudflare && wrangler deploy --dry-run --outdir dist --env production --containers-rollout none",
    "cf:check": "cd packages/cloudflare && wrangler types --strict-vars false --check && tsc --noEmit && cd ../.. && npm run cf:fixtures -- --check && npm run cf:test && npm run cf:build",
    "cf:deploy": "node packages/cloudflare/scripts/deploy.ts",
    "cf:setup": "node packages/cloudflare/scripts/setup.ts",
    "cf:restore": "node packages/cloudflare/scripts/restore.ts",
    "lint:react": "eslint packages/design-system/src packages/web/src site/src --max-warnings 0",
    "release": "node scripts/release.ts",
    "check:config": "node scripts/check_config_docs.ts",
    "acceptance": "npm run build:cli && node scripts/acceptance.ts",
    "workflow": "npm run build:cli && node scripts/workflow.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:server": "node scripts/test_server.ts",
    "docker:workflow": "npm run build:cli && node scripts/docker_workflow.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.6.2",
    "puppeteer": "25.16.0",
    "rolldown": "1.2.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "overrides": {
    "miniflare": "5.20260921.0-alpha",
    "undici": "7.29.1"
  }
}
