{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["bun"]
  },
  "include": [
    "packages/core",
    "packages/service",
    "packages/server",
    "packages/cli",
    "packages/web",
    "scripts",
    "site",
    "e2e",
    "acceptance",
    "packages/cloudflare/scripts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
