# Local development data (SQLite file, generated secret key)
.quaso/
# SQLite's side files, written next to any database that is opened
*.sqlite-shm
*.sqlite-wal
# Local planning notes
/plans/
# Cloudflare local secrets
.dev.vars
.dev.vars.*
!.dev.vars.example
# The Cloudflare package: Wrangler's local state and its build (node_modules/, .wrangler/
# and dist/ are ignored everywhere, below)
packages/cloudflare/.wrangler/
packages/cloudflare/dist/
# Operator settings
quaso.cloudflare.jsonc
.env
.env.*
!.env.example
# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo
.wrangler/
coverage/
# Editors and systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.log
# LLM Stuff
.agents
.claude
AGENTS.md
CLAUDE.md
